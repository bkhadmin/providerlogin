# Provider Login - Environment Configuration

# ===== Provider ID (สธ.) =====
PROVIDER_ID_BASE_URL=https://provider.id.th
PROVIDER_CLIENT_ID=YOUR_CLIENT_ID_HERE
PROVIDER_SECRET_KEY=YOUR_SECRET_KEY_HERE

# ===== Health ID OAuth =====
# UAT (ทดสอบ): https://uat-moph.id.th
# PRD (ใช้งานจริง): https://moph.id.th
HEALTH_ID_OAUTH_URL=https://moph.id.th
HEALTH_ID_CLIENT_ID=YOUR_HEALTH_ID_CLIENT_ID
HEALTH_ID_CLIENT_SECRET=YOUR_HEALTH_ID_CLIENT_SECRET
HEALTH_ID_REDIRECT_URI=http://localhost:3000/api/auth/callback

# ===== Application =====
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000

# ===== Security Secrets (เปลี่ยนให้เป็น random string ยาวๆ ก่อน production) =====
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-64-characters-long
SESSION_SECRET=change-this-session-secret-too-min-64-chars-for-production-use

# ===== CORS - Allowed Origins (คั่นด้วย comma) =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ===== Rate Limiting =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ===== MySQL Database =====
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=YOUR_MYSQL_PASSWORD
DB_NAME=providerlogin
DB_CONNECTION_LIMIT=10
